# ELOM frontend — environment template. Copy to the mode file you need:
#   .env.development  (used by `npm run dev`)
#   .env.production   (used by `npm run build` for prod; gitignored)
#
# Base URL of the ELOM REST API (includes the /api/v1 prefix).
VITE_API_URL=http://localhost:8000/api/v1
# Production example:
# VITE_API_URL=https://api.elom.uz/api/v1
